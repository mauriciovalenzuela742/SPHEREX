{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AstroTrack",
  "version": "0.4.2",
  "identifier": "app.astrotrack.spherex",
  "build": {
    "frontendDist": "../offline"
  },
  "app": {
    "windows": [
      {
        "title": "AstroTrack · SPHEREx",
        "url": "https://spherex-planet-x-tau.vercel.app",
        "width": 1200,
        "height": 800,
        "minWidth": 360,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "Visor público de imágenes de SPHEREx",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
