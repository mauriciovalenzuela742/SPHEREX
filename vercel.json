{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd scaffold/frontend && npm ci",
  "buildCommand": "cd scaffold/frontend && npm run build",
  "outputDirectory": "scaffold/frontend/dist",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://spherex-api.vercel.app/api/:path*"
    },
    {
      "source": "/proto-api/:path*",
      "destination": "https://spherex-prototipo-d2.vercel.app/api/:path*"
    }
  ]
}
