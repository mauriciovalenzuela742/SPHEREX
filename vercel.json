{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "root": "deploy/api",
      "framework": "fastapi"
    },
    "prototipo": {
      "root": "deploy/prototipo",
      "framework": "fastapi"
    },
    "rango_fechas": {
      "root": "prototipos/rango_fechas",
      "framework": "fastapi"
    },
    "backend": {
      "root": "scaffold/backend",
      "framework": "fastapi"
    },
    "frontend": {
      "root": "scaffold/frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
